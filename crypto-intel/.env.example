# crypto-intel (M1) configuration.
# Copy to `.env` and fill in. NEVER commit the real .env.

# --- Notion (REQUIRED) ---
# Internal integration token. Scope it to ONLY the "Crypto Market Intelligence OS"
# page tree — not your whole workspace. Create at https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxx

# The "Live Market Snapshots" database id (machine-owned feed).
NOTION_MARKET_DB_ID=09e368d0-7135-4793-ba0d-9faf9eb5357f

# Paper-trading databases (machine-owned; simulated fake-money only).
NOTION_PAPER_TRADES_DB_ID=bcfef266-9292-4de3-b9a3-8df973d45a68
NOTION_PAPER_PORTFOLIO_DB_ID=015a4e75-df51-41e4-88ca-aff2e789c0ec

# Paper account starting balance (USD). Used when the paper loop is added (Step 4).
PAPER_STARTING_CASH_USD=100000

# --- CoinGecko (OPTIONAL) ---
# Free demo key raises rate limits. Leave blank to use the public endpoint.
# Demo key -> default base url; Pro key -> set COINGECKO_BASE_URL to the pro host.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Scheduler (OPTIONAL) ---
# Used only with `npm run loop`. Minutes between snapshots. Default 15.
INTERVAL_MINUTES=15
